{
  "name": "koradest",
  "productName": "Koradest",
  "version": "1.1.1",
  "description": "KORADEST - Kernel Operativo e Architettura Dinamica per l'Espansione e lo Sviluppo Tecnologico",
  "author": "NunzioTech",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/AprileNunzio/Koradest.git"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build": "electron-builder",
    "build:local": "npx -y rimraf dist && npm version patch --no-git-tag-version && electron-builder --publish never",
    "build:publish": "node scripts/publish.js",
    "verify:store": "node scripts/verifica_store_esegui.js",
    "verify:renderer": "node scripts/verifica_renderer.js",
    "verify": "npm run verify:store && npm run verify:renderer && npm run verify:stili && npm run verify:permessi && npm run verify:font && npm run verify:catch && npm run test:sicurezza && npm run test:kernel",
    "test:kernel": "node tests/dependency_resolver.test.js && node tests/kernel.test.js && node tests/manifest_v2.test.js && node tests/app_runtime_v2.test.js",
    "verify:stili": "node scripts/verifica_stili.js",
    "verify:permessi": "node scripts/verifica_permessi_ipc.js",
    "test:sicurezza": "node tests/shamir.test.js && node tests/recovery_kit.test.js && node tests/archive_export.test.js && node tests/gdpr_erasure.test.js && node tests/retention.test.js && node tests/crypto_worker.test.js && node tests/rate_limiter.test.js && node tests/rbac_permissions.test.js && node tests/ipc_guard.test.js && node tests/capability_broker.test.js && node tests/ipc_router.test.js",
    "verify:font": "node scripts/verifica_font_locali.js",
    "verify:catch": "node scripts/verifica_catch_vuoti.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^11.0.0",
    "adm-zip": "^0.6.0",
    "basic-ftp": "^6.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "bonjour-service": "^1.4.2",
    "cors": "^2.8.6",
    "docx-templates": "^4.15.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.1",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "strip-comments": "^2.0.1"
  },
  "build": {
    "files": [
      "**/*",
      "!.claude${/*}",
      "!.agents${/*}",
      "!.cursor${/*}",
      "!.gemini${/*}",
      "!.github${/*}",
      "!.cursorrules",
      "!patch_*.js",
      "!**/CLAUDE.md",
      "!**/AGENTS.md",
      "!**/GEMINI.md",
      "!.env",
      "!.env.*",
      "!**/*.key",
      "!**/*.pem",
      "!**/*.pfx",
      "!dist${/*}",
      "!docs${/*}",
      "!logs${/*}",
      "!scratch${/*}",
      "!scripts${/*}",
      "!tests${/*}",
      "!CHANGELOG.md"
    ],
    "appId": "com.koradest.app",
    "productName": "Koradest",
    "copyright": "Copyright © 2026 NunzioTech",
    "artifactName": "Koradest-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "AprileNunzio",
        "repo": "Koradest",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "koradest.ico",
      "target": [
        "nsis"
      ],
      "publisherName": "NunzioTech",
      "legalTrademarks": "NunzioTech",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Koradest",
      "uninstallDisplayName": "Koradest",
      "installerIcon": "koradest.ico",
      "uninstallerIcon": "koradest.ico",
      "installerHeaderIcon": "koradest.ico",
      "packElevateHelper": true,
      "runAfterFinish": true,
      "include": "installer.nsh"
    }
  }
}
